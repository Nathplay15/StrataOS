    <string name="sync_no_conflicts">没有冲突。</string>
    <string name="sync_conflicts_help">两侧都有更改：两个版本均已保留，手机上的版本使用所示名称。</string>
    <string name="sync_conflicts_clear">清空列表</string>
    <string name="sync_conflicts_title">同步冲突</string>
    <string name="sync_skipped">未同步</string>
    <string name="sync_trash_help">被同步删除的手机文件会在手机文件夹的 .trash 文件夹中保留 30 天。</string>
    <string name="sync_brake_title">将删除大量文件</string>
