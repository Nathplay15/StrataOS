    <string name="sync_share_read_only">只读</string>
    <string name="sync_read_only">此文件夹只能读取：请选择 NAS → 手机，或选择其他文件夹。</string>
    <string name="sync_app_folder">应用文件夹</string>
    <string name="sync_app_folder_help">应用自有存储（Android/data）中的文件夹，随应用一同删除。其他应用无法看到它。</string>
    <string name="sync_app_folder_name">文件夹名称</string>
    <string name="sync_phone_help">可选择手机或存储卡上的任意文件夹；应用会保留使用该文件夹的权限。</string>
    <string name="sync_folders_fixed">如需使用其他文件夹，请删除此配对并添加新的配对。</string>
    <string name="sync_folder_used">另一个配对已在使用此手机文件夹。</string>
    <string name="sync_when">时机</string>
    <string name="sync_when_help">最快每 15 分钟一次；应用打开期间，NAS 上有更改后数秒内同步。省电模式开启时不会同步。“立即同步”不受这些条件限制。</string>
    <string name="sync_excluded">排除的子文件夹</string>
    <string name="sync_excluded_field">子文件夹</string>
    <string name="sync_excluded_help">每行一个，例如 Videos/Raw</string>
