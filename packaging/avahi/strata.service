<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">StrataOS on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>7070</port>
  </service>
  <!-- Found by the StrataOS app: HTTPS API port, plain HTTP port. -->
  <service>
    <type>_strataos._tcp</type>
    <port>7443</port>
    <txt-record>https=7443</txt-record>
    <txt-record>http=7070</txt-record>
    <txt-record>api=1</txt-record>
  </service>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=RackMac</txt-record>
  </service>
</service-group>
