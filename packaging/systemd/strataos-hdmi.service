# The StrataOS cinema menu on a TV plugged to the HDMI output: a kiosk browser
# kept on the connected display by "strata hdmi". Enabled and disabled by the
# daemon (Settings -> Console screen), only useful with a display attached.
# The runner starts a private Xorg (which needs root for the display) and runs
# the browser as the unprivileged strata-kiosk account, with its own /tmp.
[Unit]
Description=StrataOS cinema menu on the HDMI output
After=strata.service network-online.target
Wants=network-online.target
ConditionPathExists=/sys/class/drm

[Service]
Type=simple
ExecStart=/usr/bin/strata hdmi
Restart=always
RestartSec=5
User=root
PrivateTmp=yes
KillMode=control-group

[Install]
WantedBy=multi-user.target
