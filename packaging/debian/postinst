#!/bin/sh
set -e
case "$1" in
  configure)
    getent group strata >/dev/null || groupadd --system strata
    mkdir -p /var/lib/strata /srv/strata
    chmod 700 /var/lib/strata
    chmod 755 /srv/strata
    # Detected arrays must be assembled at boot.
    mkdir -p /etc/mdadm
    touch /etc/mdadm/mdadm.conf
    # Treat every array as local (so degraded arrays can be started at boot) and drop
    # volatile "spares=N" hints that delay assembly when a disk is missing.
    sed -i -E '/^HOMEHOST/d; /^ARRAY/ s/ spares=[0-9]+//' /etc/mdadm/mdadm.conf
    sed -i '1i HOMEHOST <ignore>' /etc/mdadm/mdadm.conf
    command -v update-initramfs >/dev/null && update-initramfs -u >/dev/null 2>&1 || true
    # On a Btrfs system (StrataOS ISO), the settings live in their own subvolume
    # so that system restore points never roll them back.
    if [ -d /run/systemd/system ]; then systemctl stop strata.service >/dev/null 2>&1 || true; fi
    /usr/bin/strata -prepare-data || echo "warning: settings left on the system subvolume"
    # Enabling works without a running systemd too (installation from the ISO,
    # inside the installer's chroot): the services then start at first boot.
    systemctl enable strata.service >/dev/null 2>&1 || true
    systemctl enable smbd.service nmbd.service nfs-server.service >/dev/null 2>&1 || true
    systemctl enable wsdd2.service >/dev/null 2>&1 || true
    systemctl enable docker.service >/dev/null 2>&1 || true
    # samba (Recommends) pulls in the AD domain controller unit: StrataOS is a standalone server.
    if ! grep -qi "server role *= *active directory" /etc/samba/smb.conf 2>/dev/null; then
      systemctl disable samba-ad-dc.service >/dev/null 2>&1 || true
      systemctl mask samba-ad-dc.service >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      systemctl stop samba-ad-dc.service >/dev/null 2>&1 || true
      systemctl restart strata.service || true
      # The console screen runs the binary too (the daemon enables it).
      systemctl try-restart strata-console.service >/dev/null 2>&1 || true
      systemctl start smbd.service nmbd.service nfs-server.service >/dev/null 2>&1 || true
      systemctl start wsdd2.service >/dev/null 2>&1 || true
      systemctl start docker.service >/dev/null 2>&1 || true
      systemctl reload avahi-daemon.service >/dev/null 2>&1 || true
    fi
    IP=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo ""
    echo "  StrataOS is running: http://${IP:-<server-ip>}:7070  (HTTPS: port 7443)"
    echo ""
    ;;
esac
exit 0
