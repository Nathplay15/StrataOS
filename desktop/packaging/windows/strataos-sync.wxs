<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user installer of StrataOS Sync (no administrator rights needed):
     %LocalAppData%\Programs\StrataOS Sync, a Start menu shortcut, and an
     entry in Apps & features. Built with WiX 4+ on a Windows runner:
       wix build -arch x64 -d Version=0.8.0 -d Src=<folder of the exe> strataos-sync.wxs -o strataos-sync.msi
     The app turns start at login on at its first launch. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="StrataOS Sync" Manufacturer="StrataOS" Version="$(var.Version)" Scope="perUser" Compressed="yes"
           UpgradeCode="65ce5de6-7b51-4d6a-b6cd-e7f6a58c2ee2" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of StrataOS Sync is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.Src)\strataos-sync.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Nathplay15/StrataOS" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="StrataOS Sync">
          <Component Id="App">
            <File Id="AppExe" Source="$(var.Src)\strataos-sync.exe" />
            <File Id="Readme" Source="$(var.Src)\README.txt" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\StrataOS\Sync" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Shortcut">
        <Shortcut Id="StartMenuShortcut" Name="StrataOS Sync" Description="Synchronizes folders with a StrataOS NAS"
                  Target="[INSTALLFOLDER]strataos-sync.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\StrataOS\Sync" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="StrataOS Sync">
      <ComponentRef Id="App" />
      <ComponentRef Id="Shortcut" />
    </Feature>
  </Package>
</Wix>
