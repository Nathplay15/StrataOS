{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StrataOS Desktop",
  "mainBinaryName": "strataos-desktop",
  "version": "0.10.1",
  "identifier": "io.github.nathplay15.strataos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StrataOS",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: http://127.0.0.1:*",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "StrataOS",
    "homepage": "https://github.com/Nathplay15/StrataOS",
    "category": "Utility",
    "shortDescription": "Folder sync, files and management of StrataOS NAS",
    "longDescription": "The StrataOS desktop app keeps folders of this computer synchronized with StrataOS NAS (end-to-end encrypted folders too), browses and shares their files and manages them: storage, shared folders, users, apps, virtual machines, backups and updates.",
    "copyright": "StrataOS contributors",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/strataos-sync"],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [],
        "conflicts": ["strataos-sync"],
        "replaces": ["strataos-sync"],
        "provides": ["strataos-sync"],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "German", "Spanish", "Italian", "Dutch", "PortugueseBR", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["strataos"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQjU2MkMyRERDRkZCNDkKUldSSis4L2R3bUsxa2M5dFppYUFvcnVWNWN4Yk9aZ0RkVllqeVhiM3JNNlJBcTJtNU1jNkNBSDkK",
      "endpoints": ["https://github.com/Nathplay15/StrataOS/releases/latest/download/latest.json"]
    }
  }
}
